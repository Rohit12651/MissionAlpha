# Agent Runtime config. Copy to `.env` (gitignored) and fill ANTHROPIC_API_KEY.
# Get a key: https://console.anthropic.com/settings/keys
# NEVER commit the real key. NEVER paste it into chat.

ANTHROPIC_API_KEY=

# Optional overrides:
RUNTIME_MODEL=claude-sonnet-4-6
RUNTIME_PORT=3005
RUNTIME_MAX_TOKENS=1024
