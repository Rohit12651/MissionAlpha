{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/id_rsa*)",
      "Read(**/credentials*)",
      "Read(**/secrets*)",
      "Read(**/.claude/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/.git/**)",
      "Read(**/.runtime-token)"
    ]
  }
}