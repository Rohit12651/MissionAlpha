{
  "name": "missionalpha",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 3004",
    "build": "tsc && vite build",
    "preview": "vite preview --port 3004",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test src/lib/__tests__/*.test.ts test/visual/*.test.mjs",
    "test:runtime": "node --test --test-concurrency=1 agent-runtime/__tests__/*.test.mjs agent-runtime/test/*.test.mjs",
    "test:vendor": "node --test scripts/lib/__tests__/*.test.mjs",
    "test:electron": "node --test electron/test/*.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "reset:dev": "node scripts/reset-dev.mjs",
    "vendor:skills": "node scripts/vendor-skills.mjs",
    "gen:skills": "node scripts/gen-skills.mjs",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on tcp:3004 && RUNTIME_BACKEND=cli electron .\"",
    "electron:build": "npm run build && electron-builder",
    "test:visual": "playwright test test/visual --config=playwright.config.mjs",
    "test:visual:update": "playwright test test/visual --config=playwright.config.mjs --update-snapshots",
    "test:visual:record": "VISUAL_RECORD=1 playwright test test/visual/record.spec.mjs --config=playwright.config.mjs",
    "preview:visual": "vite preview --port 3007 --strictPort"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/postprocessing": "^3.0.0",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.507.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.8.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.3.3",
    "wait-on": "^8.0.5"
  },
  "description": "MissionAlpha — standalone agent swarm command tower (watches Waahyu + future swarms)"
}
