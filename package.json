{
  "name": "missionalpha",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 3004",
    "build": "tsc && vite build",
    "preview": "vite preview --port 3004",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test src/lib/__tests__/*.test.ts",
    "test:vendor": "node --test scripts/lib/__tests__/vendor.test.mjs",
    "vendor:skills": "node scripts/vendor-skills.mjs",
    "gen:skills": "node scripts/gen-skills.mjs",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on tcp:3004 && RUNTIME_BACKEND=cli electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/postprocessing": "^3.0.0",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.507.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "wait-on": "^8.0.5"
  },
  "description": "MissionAlpha — standalone agent swarm command tower (watches Waahyu + future swarms)"
}
