# MissionAlpha data source — absolute path to the swarm state.json to visualize.
# Self-contained default = MissionAlpha's own agent-status.
WAAHYU_STATE_PATH=/Users/RohitAnandeshi/Downloads/WaahyuFOLDER/MissonAlpha/agent-status/state.json
# Watch an external swarm (e.g. Waahyu) by pointing at its exported state instead:
# WAAHYU_STATE_PATH=/Users/RohitAnandeshi/Downloads/WaahyuFOLDER/WaahyuPython/agent-status/state.json

# ── P2 Delivery engine + event bus (ADR-051 / ADR-052) ────────────────────────
# SQLite store backing the Inbox (deliveries) and the SSE replay log (events_log).
# Created 0600 with its parent dir 0700; patch bodies live beside it in ./patches/.
# `agent-runtime/data/` is gitignored. Default: agent-runtime/data/mission.db
# RUNTIME_DB_PATH=/absolute/path/to/mission.db
#
# ── P3 Inbox UI (program plan §5.1) ──────────────────────────────────────────
# Feature flag for the Helm Inbox surface. UNSET or anything other than 0/false
# ⇒ ON: the Inbox is the default shell view, the SSE bus is subscribed once, and
# the pending badge lights up in the title bar + status strip.
# Set to 0 to render the pre-P3 cockpit unchanged — no toggle, no skin attribute,
# no SSE subscription, and the Inbox chunk is never fetched. This is the P3
# kill-switch (program plan point 9).
# VITE_INBOX=0

# Max concurrent SSE clients on GET /runtime/events. This is a loopback,
# single-operator tool — the cap only guards runaway tab leaks. SSE connections do
# NOT consume RUNTIME_MAX_INFLIGHT (they spawn no child). Default: 16
# RUNTIME_MAX_SSE_CLIENTS=16

# ── P5 workspace + PR ladder (any repo · worktrees · real PRs) ────────────────
# Where the runtime keeps its OWN config — currently just the persisted workspace
# choice, written 0600 inside a 0700 dir. Defaults under RUNTIME_TOKEN_DIR, i.e.
# outside every repo (an in-repo config would be agent-readable).
# RUNTIME_CONFIG_DIR=/absolute/path/to/config
#
# Workspace precedence, highest first:
#   1. RUNTIME_REPO_ROOT (below)  2. the persisted config  3. MissionAlpha itself
# Setting RUNTIME_REPO_ROOT PINS the target repo (CI, launcher) and makes the
# Settings picker read-only. REPO_ROOT is immutable for a runtime process, so a
# workspace change from the UI takes effect on the next runtime start.
#
# Commit identity used by approve→commit. Deliberately non-personal: the runtime
# never reads or writes your global git config.
# RUNTIME_COMMIT_NAME=MissionAlpha
# RUNTIME_COMMIT_EMAIL=missionalpha@localhost
#
# Per-command timeout for the git/gh calls in the approve ladder (ms). Default 60000.
# RUNTIME_PR_TIMEOUT_MS=60000
